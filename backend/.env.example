PORT=4001
NODE_ENV=development

# ── Apple Passkey / WebAuthn Auth ──────────────────────────────────────────────
# Secret for signing httpOnly session cookies
COOKIE_SECRET=change-me-to-a-random-64-char-string

# Set to 'true' ONLY temporarily to reset a locked-out passkey (remove after use)
ALLOW_PASSKEY_RESET=false

# ── CORS — your frontend domain ────────────────────────────────────────────────
ALLOWED_ORIGIN=https://yourdomain.com

# ── Supabase backup (optional — used by backupScheduler) ───────────────────────
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── GitHub OAuth integration (optional) ────────────────────────────────────────
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret
